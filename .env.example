# .env 로 복사해서 값을 채운다. .env 는 Git에 올라가지 않는다.

# 로컬 compose DB (기본값과 같으면 생략 가능)
DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant_lab

# 토스 Open API. client는 계정당 1개라 서버 Worker가 돌고 있으면 로컬에서 쓰지 않는다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# Worker 시세 공급원. stored: DB 저장분만 사용(토스 호출 없음, 로컬 기본), toss: 운영 서버
WORKER_MARKET_SOURCE=stored

# 실제 토스 계좌 읽기 (실거래 R1). toss 모드에서만 동작, 한 시간마다 잔고·보유·최근 주문을 읽는다. 주문은 내지 않는다
TOSS_ACCOUNT_ENABLED=false

# 실거래 스위치 (실거래 R2). true여야 Worker가 주문 어댑터를 만든다. 봇마다 "실제로 따라 사기"도 켜야 하고,
# 처음 몇 번은 화면에서 승인해야 실제 주문이 나간다
LIVE_TRADING=false

# 텔레그램 알림 (선택). @BotFather로 봇을 만들고, 봇에게 메시지를 보낸 뒤 `cli notify chat-id`로 채팅 ID 확인
# 텔레그램 알림은 기본으로 꺼져 있다 (2026-10-02). 켜려면 true
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 외부 생존 감시 (선택). Healthchecks.io 체크의 ping URL. Worker·PC가 멈추면 그쪽에서 알린다
HEARTBEAT_PING_URL=

# 매일 일봉을 갱신할 관심 종목 (선택, 쉼표 구분, 기본 10종목)
# WATCHLIST_SYMBOLS=QQQ,VOO,QLD,TQQQ,SOXL,NVDA,GLD,MAGS,EWY,EWJ
